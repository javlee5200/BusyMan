{
  "info": {
    "name": "BusyMan API",
    "description": "Colección base para autenticación JWT y módulos clientes/equipos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "username",
      "value": "api_tester"
    },
    {
      "key": "password",
      "value": "ApiTest12345!"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "clienteId",
      "value": "1"
    },
    {
      "key": "equipoId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Obtener token JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/token/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "token",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let data = pm.response.json();",
                  "if (data.access) pm.collectionVariables.set('accessToken', data.access);",
                  "if (data.refresh) pm.collectionVariables.set('refreshToken', data.refresh);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/token/refresh/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "token",
                "refresh",
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Listar clientes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clientes/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clientes",
                ""
              ]
            }
          }
        },
        {
          "name": "Crear cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Demo\",\n  \"apellidos\": \"Cliente\",\n  \"tipo_documento\": \"CC\",\n  \"numero_documento\": \"990001001\",\n  \"telefono\": \"3009990001\",\n  \"email\": \"demo.cliente@example.com\",\n  \"direccion\": \"Calle Demo 1\",\n  \"activo\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/clientes/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clientes",
                ""
              ]
            }
          }
        },
        {
          "name": "Detalle cliente",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clientes/{{clienteId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clientes",
                "{{clienteId}}",
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Equipos",
      "item": [
        {
          "name": "Listar equipos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/equipos/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "equipos",
                ""
              ]
            }
          }
        },
        {
          "name": "Listar equipos por estado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/equipos/?estado=INGRESADO",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "equipos",
                ""
              ],
              "query": [
                {
                  "key": "estado",
                  "value": "INGRESADO"
                }
              ]
            }
          }
        },
        {
          "name": "Actualizar estado equipo",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado_actual\": \"DIAGNOSTICO\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/equipos/{{equipoId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "equipos",
                "{{equipoId}}",
                ""
              ]
            }
          }
        }
      ]
    }
  ]
}
